# Vehicle Routing Web - local configuration
# See src/vehicle_routing_web/infrastructure/settings.py (AppSettings)
# All variables are prefixed with VRW_.

VRW_HOST=127.0.0.1
VRW_PORT=8050
VRW_DEBUG=false
VRW_LOG_LEVEL=INFO

# Base URL of the vehicle-routing-service FastAPI app
VRW_API_BASE_URL=http://localhost:8000
VRW_API_TIMEOUT_SECONDS=300

# Relative paths resolve against the working directory (run from apps/vehicle-routing-web).
VRW_STORAGE_DIR=./storage
VRW_MAX_UPLOAD_BYTES=52428800
