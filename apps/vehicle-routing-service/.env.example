# Vehicle Routing Service - local configuration
# See src/vehicle_routing_service/infrastructure/config/settings.py (AppSettings)
# All variables are prefixed with VRS_. Uncomment/edit as needed.

VRS_HOST=0.0.0.0
VRS_PORT=8000

# JSON list of allowed CORS origins. "*" allows any origin (fine for local dev).
VRS_CORS_ORIGINS=["*"]

# DEBUG, INFO, WARNING, ERROR, CRITICAL
VRS_LOG_LEVEL=INFO
